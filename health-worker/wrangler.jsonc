{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nitterts-health",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "HEALTH_METRICS", "class_name": "HealthMetrics" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HealthMetrics"] }
  ]
}
